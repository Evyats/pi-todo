[Unit]
Description=Pi Todo FastAPI service
After=network.target

[Service]
Type=simple
User=pi-todo
Group=pi-todo
WorkingDirectory=/opt/pi-todo/app/backend
Environment=TODO_DATABASE_PATH=/var/lib/pi-todo/tasks.db
ExecStart=/opt/pi-todo/venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8000
Restart=on-failure
RestartSec=5

NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/pi-todo

[Install]
WantedBy=multi-user.target
